# Copy to .env before `docker compose up` if you need to override defaults.
# All configuration is read from environment variables (12-factor).

# Host Ollama (default on Docker Desktop for Mac: host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Models (both must be pulled on the host: ollama pull ...)
LLM_MODEL=qwen2.5:7b
LLM_FALLBACK_MODEL=qwen2.5:3b

# Ollama request timeout (seconds); on timeout the call retries once with the fallback model
LLM_TIMEOUT_S=45

# BM25 grounding threshold (replace with the calibrated value from eval/run_eval.py)
RETRIEVAL_THRESHOLD=3.0

# Linux only: make the host Ollama reachable from containers.
# Run Ollama with OLLAMA_HOST=0.0.0.0 on the host, or set:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
